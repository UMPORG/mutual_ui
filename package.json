{
  "name": "@umporg/ui",
  "version": "0.24.0",
  "description": "MUTU@L design system: tokens, brand, shell pieces, form controls, overlays, dates, cards, stats, charts, tables, conversation (assistant) components, decorative effects and SSO helpers shared by every MUTU@L app.",
  "license": "UNLICENSED",
  "type": "module",
  "sideEffects": [
    "*.css"
  ],
  "files": [
    "css",
    "src",
    "assets",
    "README.md"
  ],
  "exports": {
    ".": "./src/index.ts",
    "./sso": "./src/sso.ts",
    "./seguranca": "./src/seguranca.js",
    "./cerebro": "./src/cerebro.ts",
    "./consultas": "./src/consultas.ts",
    "./apps": "./src/apps.ts",
    "./icones": "./src/icones.ts",
    "./formatar": "./src/formatar.ts",
    "./validar": "./src/validar.ts",
    "./graficos": "./src/graficos.tsx",
    "./controlos": "./src/controlos.ts",
    "./datas": "./src/datas.tsx",
    "./calendario": "./src/calendario.ts",
    "./efeitos": "./src/efeitos.ts",
    "./conversa": "./src/conversa.ts",
    "./preencher": "./src/preencher.tsx",
    "./assistente": "./src/assistente-chat.tsx",
    "./markdown": "./src/markdown.tsx",
    "./monitor": "./src/monitor.ts",
    "./monitor/react": "./src/monitor-react.tsx",
    "./css/index.css": "./css/index.css",
    "./css/tokens.css": "./css/tokens.css",
    "./css/theme.css": "./css/theme.css",
    "./css/superficies.css": "./css/superficies.css",
    "./css/preferencias.css": "./css/preferencias.css",
    "./css/dados.css": "./css/dados.css",
    "./css/controlos.css": "./css/controlos.css",
    "./css/efeitos.css": "./css/efeitos.css",
    "./css/conversa.css": "./css/conversa.css",
    "./css/rolagem.css": "./css/rolagem.css",
    "./css/dicas.css": "./css/dicas.css",
    "./css/shell.css": "./css/shell.css",
    "./css/assistente.css": "./css/assistente.css",
    "./preferencias": "./src/preferencias.ts",
    "./assets/*": "./assets/*"
  },
  "scripts": {
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.solto.json",
    "test": "vp test run",
    "embed-logo": "node scripts/embed-logo.mjs",
    "icones": "node --experimental-strip-types scripts/gerar-icones.mjs",
    "hooks": "node scripts/preparar.mjs"
  },
  "peerDependencies": {
    "@base-ui/react": ">=1.6.0 <2",
    "@tanstack/react-query": ">=5.100.0 <6",
    "lucide-react": ">=0.400.0",
    "react": ">=19",
    "react-dom": ">=19",
    "recharts": ">=3.1.0"
  },
  "peerDependenciesMeta": {
    "@base-ui/react": {
      "optional": true
    },
    "@tanstack/react-query": {
      "optional": true
    },
    "recharts": {
      "optional": true
    }
  },
  "devDependencies": {
    "@base-ui/react": "1.9.0",
    "@secretlint/secretlint-rule-preset-recommend": "13.0.7",
    "@tanstack/react-query": "5.104.2",
    "@types/node": "24.19.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "lucide-react": "1.57.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "recharts": "3.10.1",
    "secretlint": "13.0.7",
    "typescript": "7.0.2",
    "vite-plus": "1.2.0"
  },
  "packageManager": "pnpm@12.11.2",
  "engines": {
    "node": ">=24.21.0 <25"
  }
}
