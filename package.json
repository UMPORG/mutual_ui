{
  "name": "@umporg/ui",
  "version": "0.6.0",
  "description": "MUTU@L design system: tokens, brand, shell pieces, cards, stats, charts, tables and SSO helpers shared by every MUTU@L app.",
  "license": "UNLICENSED",
  "type": "module",
  "sideEffects": [
    "*.css"
  ],
  "files": [
    "css",
    "src",
    "assets",
    "README.md"
  ],
  "exports": {
    ".": "./src/index.ts",
    "./sso": "./src/sso.ts",
    "./apps": "./src/apps.ts",
    "./formatar": "./src/formatar.ts",
    "./graficos": "./src/graficos.tsx",
    "./css/index.css": "./css/index.css",
    "./css/tokens.css": "./css/tokens.css",
    "./css/theme.css": "./css/theme.css",
    "./css/superficies.css": "./css/superficies.css",
    "./css/preferencias.css": "./css/preferencias.css",
    "./css/dados.css": "./css/dados.css",
    "./preferencias": "./src/preferencias.ts",
    "./assets/*": "./assets/*"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "node --import ./tests/resolver.mjs --test --experimental-strip-types tests/*.test.ts",
    "embed-logo": "node scripts/embed-logo.mjs"
  },
  "peerDependencies": {
    "lucide-react": ">=0.400.0",
    "react": ">=19",
    "recharts": ">=3.1.0"
  },
  "peerDependenciesMeta": {
    "recharts": {
      "optional": true
    }
  },
  "devDependencies": {
    "@types/node": "^25.9.8",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.3.0",
    "lucide-react": "^1.6.0",
    "react": "^19.2.4",
    "react-dom": "^19.3.0",
    "recharts": "^3.10.1",
    "typescript": "^5.9.3"
  },
  "packageManager": "pnpm@10.24.0"
}
