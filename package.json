{
  "name": "@umporg/ui",
  "version": "0.8.1",
  "description": "MUTU@L design system: tokens, brand, shell pieces, form controls, overlays, dates, cards, stats, charts, tables, conversation (assistant) components, decorative effects and SSO helpers shared by every MUTU@L app.",
  "license": "UNLICENSED",
  "type": "module",
  "sideEffects": [
    "*.css"
  ],
  "files": [
    "css",
    "src",
    "assets",
    "README.md"
  ],
  "exports": {
    ".": "./src/index.ts",
    "./sso": "./src/sso.ts",
    "./apps": "./src/apps.ts",
    "./formatar": "./src/formatar.ts",
    "./graficos": "./src/graficos.tsx",
    "./controlos": "./src/controlos.ts",
    "./datas": "./src/datas.tsx",
    "./calendario": "./src/calendario.ts",
    "./efeitos": "./src/efeitos.ts",
    "./conversa": "./src/conversa.ts",
    "./markdown": "./src/markdown.tsx",
    "./css/index.css": "./css/index.css",
    "./css/tokens.css": "./css/tokens.css",
    "./css/theme.css": "./css/theme.css",
    "./css/superficies.css": "./css/superficies.css",
    "./css/preferencias.css": "./css/preferencias.css",
    "./css/dados.css": "./css/dados.css",
    "./css/controlos.css": "./css/controlos.css",
    "./css/efeitos.css": "./css/efeitos.css",
    "./css/conversa.css": "./css/conversa.css",
    "./css/rolagem.css": "./css/rolagem.css",
    "./preferencias": "./src/preferencias.ts",
    "./assets/*": "./assets/*"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "node --import ./tests/resolver.mjs --test --experimental-strip-types tests/*.test.ts",
    "embed-logo": "node scripts/embed-logo.mjs"
  },
  "peerDependencies": {
    "@base-ui/react": ">=1.6.0 <2",
    "lucide-react": ">=0.400.0",
    "react": ">=19",
    "react-dom": ">=19",
    "recharts": ">=3.1.0"
  },
  "peerDependenciesMeta": {
    "@base-ui/react": {
      "optional": true
    },
    "recharts": {
      "optional": true
    }
  },
  "devDependencies": {
    "@base-ui/react": "1.6.0",
    "@types/node": "^25.9.8",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.3.0",
    "lucide-react": "^1.6.0",
    "react": "^19.2.4",
    "react-dom": "^19.3.0",
    "recharts": "^3.10.1",
    "typescript": "^5.9.3"
  },
  "packageManager": "pnpm@10.24.0"
}
